{
  "name": "private-ca-pdf-signing-demo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Static demo SPA: clickable POC of a private-CA PDF signing system (all data simulated).",
  "repository": {
    "type": "git",
    "url": "https://github.com/korakod-dev/private-ca-pdf-signing-demo.git"
  },
  "homepage": "https://pki-demo.korakod.dev",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort",
    "build": "npm run check:fixtures && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p cypress/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check:content": "tsx scripts/check-content.ts",
    "e2e": "start-server-and-test preview http://localhost:4173 \"cypress run\"",
    "e2e:smoke": "start-server-and-test preview http://localhost:4173 \"cypress run --spec 'cypress/e2e/smoke/**'\"",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:fixtures && npm run check:content && npm run build && npm run e2e"
  },
  "dependencies": {
    "msw": "^3.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.1",
    "cypress": "^15.21.2",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
