{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcpsd:schema:documents",
  "title": "documents.json (FixtureDocument[])",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "file_name", "title_th", "scenario_th", "pages", "size_bytes", "encrypted", "sha256", "previews",
      "signature_fields", "signatures", "doc_timestamps", "modification_after_last_signature", "expected", "refs"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^D(0[1-9]|1[0-2])(-s[0-9]+)?$" },
      "file_name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
      "title_th": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" },
      "scenario_th": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" },
      "pages": { "type": "integer", "minimum": 1 },
      "size_bytes": { "type": "integer", "minimum": 1 },
      "encrypted": { "type": "boolean" },
      "sha256": { "$ref": "urn:pcpsd:schema:common#/$defs/docSha256" },
      "previews": {
        "description": "Paths under public/. 1-3 pages per document, named <DOCID>-p<n>.svg.",
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": { "type": "string", "pattern": "^/previews/D(0[1-9]|1[0-2])(-s[0-9]+)?-p[1-3]\\.svg$" }
      },
      "signature_fields": { "type": "array", "items": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" } },
      "signatures": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "field", "type", "signer_cert_serial", "claimed_signing_time", "signature_timestamp", "level", "purpose"],
          "properties": {
            "id": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" },
            "field": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" },
            "type": { "enum": ["certification", "approval"] },
            "signer_cert_serial": { "$ref": "urn:pcpsd:schema:common#/$defs/certSerial" },
            "claimed_signing_time": { "$ref": "urn:pcpsd:schema:common#/$defs/instant" },
            "signature_timestamp": {
              "anyOf": [{ "$ref": "urn:pcpsd:schema:common#/$defs/timestamp" }, { "type": "null" }]
            },
            "level": { "enum": ["B-B", "B-T", "B-LT", "B-LTA"] },
            "purpose": { "enum": [1, 2, 3, 4, null] }
          }
        }
      },
      "doc_timestamps": { "type": "array", "items": { "$ref": "urn:pcpsd:schema:common#/$defs/timestamp" } },
      "modification_after_last_signature": {
        "anyOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "docmdp_permitted"],
            "properties": {
              "kind": { "enum": ["content_stream", "form_fill"] },
              "docmdp_permitted": { "type": "boolean" }
            }
          }
        ]
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": ["http_status", "indication", "sub_indication", "code", "problem_code", "warnings"],
        "properties": {
          "http_status": { "enum": [200, 413, 422] },
          "indication": { "enum": ["TOTAL-PASSED", "TOTAL-FAILED", "INDETERMINATE", null] },
          "sub_indication": { "enum": ["REVOKED", "NO_CERTIFICATE_CHAIN_FOUND", "NO_POE", "TRY_LATER", "HASH_FAILURE", null] },
          "code": { "enum": ["VALID", "MODIFIED", "REVOKED", "UNTRUSTED", "NO_POE", "TRY_LATER", null] },
          "problem_code": { "type": ["string", "null"] },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      },
      "refs": { "type": "array", "items": { "$ref": "urn:pcpsd:schema:common#/$defs/nonEmptyString" } }
    }
  }
}
